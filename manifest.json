{
  "manifest_version": 2,
  "name": "Pestañario",
  "version": "0.1.0",
  "description": "Explorador de archivos y base de datos para tus pestañas, que trabaja junto a Sidebery sin modificarlo.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pestanario@privado.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://github.com/drugabox/sidebery-org/releases/latest/download/updates.json"
    }
  },
  "background": {
    "scripts": [
      "lib/model.js",
      "lib/db.js",
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Pestañario (clic central: en ventana aparte)",
    "default_area": "navbar"
  },
  "options_ui": {
    "page": "explorer/explorer.html#ajustes",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "sessions",
    "menus",
    "contextualIdentities",
    "cookies"
  ],
  "optional_permissions": [
    "<all_urls>",
    "https://www.youtube.com/*"
  ],
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Abrir Pestañario"
    },
    "open-tab": {
      "description": "Abrir Pestañario en una pestaña"
    },
    "open-window": {
      "description": "Abrir Pestañario en una ventana aparte"
    }
  }
}
